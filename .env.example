# Copy to .env for local overrides. Placeholders only — never commit real secrets.
# Names follow guides/standards.md. docker-compose.yml reads this file for ${VAR} substitution.

# ==========================================
# Global
# ==========================================
ENV=dev
LOG_LEVEL=INFO
AWS_REGION=us-east-1
AWS_PROFILE=capstone-dev

# ==========================================
# PostgreSQL (shared capstone database, table-level write ownership — see docs/architecture/service-ownership-matrix.md)
# ==========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mortgage_intel
POSTGRES_USER=mortgage_app
# Local-only dev password. Must match the password your postgres volume was initialised with.
POSTGRES_PASSWORD=postgres

# ==========================================
# Messaging (SNS -> SQS -> consumers, DLQ after 3 receives)
# ==========================================
# AWS_ENDPOINT_URL: set ONLY for LocalStack. Leave empty to use the real AWS sandbox.
#   Host (running a service with mvn/uvicorn on your machine): http://localhost:4566
#   Inside docker compose the services use AWS_ENDPOINT_URL_DOCKER (default http://localstack:4566)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ENDPOINT_URL_DOCKER=http://localstack:4566
# LocalStack accepts any credentials; for real AWS use AWS_PROFILE / an IAM role instead.
LOCALSTACK_ACCESS_KEY_ID=test
LOCALSTACK_SECRET_ACCESS_KEY=test

# Producer (mortgage-service)
# Real sandbox: arn:aws:sns:us-east-1:<account-id>:capstone-mortgage-lifecycle-dev
SNS_TOPIC_MORTGAGE_EVENTS=arn:aws:sns:us-east-1:000000000000:capstone-mortgage-lifecycle-dev

# Consumer queues (host URLs; *_DOCKER variants are what containers use)
SQS_QUEUE_SERVICING_EVENTS=http://localhost:4566/000000000000/capstone-mortgage-servicing-dev
SQS_QUEUE_SERVICING_DLQ=http://localhost:4566/000000000000/capstone-mortgage-servicing-dlq-dev
SQS_QUEUE_ANALYTICS_EVENTS=http://localhost:4566/000000000000/capstone-mortgage-analytics-dev
SQS_QUEUE_ANALYTICS_DLQ=http://localhost:4566/000000000000/capstone-mortgage-analytics-dlq-dev
SQS_QUEUE_SERVICING_EVENTS_DOCKER=http://localstack:4566/000000000000/capstone-mortgage-servicing-dev
SQS_QUEUE_ANALYTICS_EVENTS_DOCKER=http://localstack:4566/000000000000/capstone-mortgage-analytics-dev
# Must equal the queue RedrivePolicy maxReceiveCount
SQS_MAX_RECEIVE_COUNT=3

# ==========================================
# Authentication (M6) — REQUIRED. Fill these in your local .env only; never commit real values.
# ==========================================
# HS256 signing key shared by mortgage-service (issues tokens), servicing-service and analytics-service (validate them).
# Must be >= 32 bytes. Generate:  openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=capstone-mortgage-auth
# Access-token lifetime (seconds). Clients log in again after expiry.
JWT_TTL_SECONDS=3600
# Local/dev only: password given to the five seed users (admin@, underwriter@, servicing@, risk@, support@capstone.local)
# the first time mortgage-service starts. Stored only as a BCrypt hash. Min 12 chars.
AUTH_SEED_PASSWORD=

# ==========================================
# Delinquency batch (mortgage-service, UTC cron) and analytics/S3
# ==========================================
DELINQUENCY_SCAN_CRON=0 0 2 * * *
S3_BUCKET_DOCUMENTS=capstone-mortgage-docs-dev
