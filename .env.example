# ==========================================
# Global Environment Settings
# ==========================================
ENV=dev
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566

# ==========================================
# Service Ports
# ==========================================
MORTGAGE_SERVICE_PORT=8080
SERVICING_SERVICE_PORT=8081

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=mortgage_app
POSTGRES_PASSWORD=postgres

# Databases per Service Boundary
MORTGAGE_DB_NAME=mortgage_intel
SERVICING_DB_NAME=servicing_intel

# ==========================================
# Messaging & Event-Driven Architecture (SNS / SQS)
# ==========================================
# SNS Topic (Event Publisher)
SNS_TOPIC_MORTGAGE_EVENTS=arn:aws:sns:us-east-1:000000000000:capstone-mortgage-lifecycle-dev

# SQS Queues (Event Consumers & DLQ)
SQS_QUEUE_SERVICING_EVENTS=http://localhost:4566/000000000000/capstone-mortgage-servicing-dev
SQS_QUEUE_SERVICING_DLQ=http://localhost:4566/000000000000/capstone-mortgage-servicing-dlq-dev
SQS_QUEUE_ANALYTICS_EVENTS=http://localhost:4566/000000000000/capstone-mortgage-analytics-dev