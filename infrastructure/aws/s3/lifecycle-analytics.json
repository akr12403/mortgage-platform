{
  "Rules": [
    {
      "ID": "dev-expire-raw-export-after-30-days",
      "Status": "Enabled",
      "Filter": { "Prefix": "${RAW_PREFIX}" },
      "Expiration": { "Days": 30 }
    },
    {
      "ID": "dev-expire-curated-after-30-days",
      "Status": "Enabled",
      "Filter": { "Prefix": "${CURATED_PREFIX}" },
      "Expiration": { "Days": 30 }
    },
    {
      "ID": "abort-incomplete-multipart-uploads",
      "Status": "Enabled",
      "Filter": {},
      "AbortIncompleteMultipartUpload": { "DaysAfterInitiation": 1 }
    }
  ]
}
