{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UploadMortgageDocuments",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::${DOCS_BUCKET}/${DOCS_UPLOAD_PREFIX}*"
    },
    {
      "Sid": "WriteRawExport",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::${ANALYTICS_BUCKET}/${RAW_PREFIX}*"
    },
    {
      "Sid": "ReadRawAndCuratedForReportsAndReconciliation",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::${ANALYTICS_BUCKET}/${RAW_PREFIX}*",
        "arn:aws:s3:::${ANALYTICS_BUCKET}/${CURATED_PREFIX}*"
      ]
    },
    {
      "Sid": "ListOnlyPipelinePrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${ANALYTICS_BUCKET}",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "${RAW_PREFIX}*",
            "${CURATED_PREFIX}*"
          ]
        }
      }
    },
    {
      "Sid": "RunAndWatchTheDelinquencyEtlJob",
      "Effect": "Allow",
      "Action": [
        "glue:StartJobRun",
        "glue:GetJobRun",
        "glue:GetJobRuns"
      ],
      "Resource": "arn:aws:glue:${REGION}:${ACCOUNT_ID}:job/${GLUE_JOB}"
    },
    {
      "Sid": "MortgageLookupReadAndUpsertByKey",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:BatchWriteItem"
      ],
      "Resource": "arn:aws:dynamodb:${REGION}:${ACCOUNT_ID}:table/${LOOKUP_TABLE}"
    },
    {
      "Sid": "ConsumeAnalyticsQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage"
      ],
      "Resource": "arn:aws:sqs:${REGION}:${ACCOUNT_ID}:${ANALYTICS_QUEUE}"
    }
  ]
}
