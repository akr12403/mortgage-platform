# Copy to your shell (or a local .env you never commit). The client reads ONLY environment variables.
MORTGAGE_API_BASE=http://localhost:8080
SERVICING_API_BASE=http://localhost:8081
MORTGAGE_API_USERNAME=servicing@capstone.local
# Local dev: the seed password from the repo-root .env (AUTH_SEED_PASSWORD). Never commit a real value.
MORTGAGE_API_PASSWORD=
MORTGAGE_API_TIMEOUT_MS=10000
# Plain HTTP is allowed for localhost only. Set to true ONLY for a trusted lab network; production must be HTTPS.
ALLOW_INSECURE_HTTP=false
