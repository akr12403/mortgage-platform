SERVICE_NAME=mortgage-analytics-service
LOG_LEVEL=INFO
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mortgage_intel
POSTGRES_USER=mortgage_app
POSTGRES_PASSWORD=change-me
AWS_REGION=us-east-1
AWS_PROFILE=capstone-dev
S3_BUCKET_DOCUMENTS=capstone-mortgage-docs-dev
# M5 optional analytics consumer (leave SQS_QUEUE_ANALYTICS_EVENTS empty to disable)
AWS_ENDPOINT_URL=http://localhost:4566
SQS_QUEUE_ANALYTICS_EVENTS=http://localhost:4566/000000000000/capstone-mortgage-analytics-dev
ANALYTICS_CONSUMER_ENABLED=true
SQS_MAX_RECEIVE_COUNT=3
