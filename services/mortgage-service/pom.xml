<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- M6 Task 6.7 (VULN-M6-018): 3.2.5 shipped Tomcat 10.1.20 with Critical CVEs (CVE-2025-24813,
             CVE-2024-50379, CVE-2024-56337). 3.5.16 is the newest 3.x release; Spring Boot 4 migration is backlog B-18. -->
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.capstone</groupId>
    <artifactId>mortgage-service</artifactId>
    <version>1.0.0</version>
    <name>mortgage-service</name>

    <properties>
        <java.version>17</java.version>
        <!-- Newest Tomcat 10.1.x on Maven Central (2026-10-06): includes every 10.1 security fix published after the
             version that Spring Boot 3.5.16 manages (10.1.55). Re-check with `sh scripts/security-gates.sh sca`. -->
        <tomcat.version>10.1.61</tomcat.version>
        <!-- Dependency-gate findings (M6 Task 6.7): patch releases newer than Spring Boot 3.5.16 manages.
             netty 4.1.135 -> 4.1.139: CVE-2026-75595 (Critical) + codec DoS CVEs (High)
             jackson 2.21.4 -> 2.21.7: CVE-2026-89407/89425/68497/91776/91777 (High, DoS)
             postgresql 42.7.11 -> 42.7.14: CVE-2026-54291 (High, SCRAM channel-binding downgrade) -->
        <netty.version>4.1.139.Final</netty.version>
        <jackson-bom.version>2.21.7</jackson-bom.version>
        <postgresql.version>42.7.14</postgresql.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>2.20.160</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- REST API Web Starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Data JPA for Database Persistence -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- PostgreSQL Runtime Driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Jakarta Validation for Request DTOs (@Valid) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Boot Actuator for Health Probes -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- M6: Spring Security + JWT (Nimbus JOSE via spring-security-oauth2-jose) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>

        <!-- AWS SDK v2 SNS & SQS -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sns</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sqs</artifactId>
        </dependency>

        <!-- Contract test: validates produced events against docs/architecture/events/*.schema.json -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>1.0.87</version>
            <scope>test</scope>
        </dependency>

        <!-- Testing Starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>