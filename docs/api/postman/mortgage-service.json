{
  "info": {
    "_postman_id": "mortgage-service-api-collection",
    "name": "Mortgage Service API Collection",
    "description": "Postman collection covering Borrowers, Mortgages, Payment Posting, and Validation flows for the Mortgage Microservice.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Borrowers",
      "item": [
        {
          "name": "Create Borrower",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "borrower-create-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"phoneNumber\": \"555-0192\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/borrowers",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "borrowers"]
            },
            "description": "Create a new borrower profile."
          },
          "response": []
        },
        {
          "name": "Get Borrower By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "borrower-get-001"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/v1/borrowers/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "borrowers", "1"]
            },
            "description": "Retrieve borrower details by ID."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Mortgages",
      "item": [
        {
          "name": "Create Mortgage",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "mortgage-create-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loanAmount\": 250000.00,\n  \"interestRate\": 0.0450,\n  \"termYears\": 30,\n  \"propertyAddress\": \"123 Main Street, Cityville, ST 12345\",\n  \"borrowerId\": 1\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/mortgages",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "mortgages"]
            },
            "description": "Create a new mortgage linked to a borrower."
          },
          "response": []
        },
        {
          "name": "Get Mortgage By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "mortgage-get-001"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/v1/mortgages/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "mortgages", "1"]
            },
            "description": "Retrieve mortgage details including outstanding balance."
          },
          "response": []
        },
        {
          "name": "Get Mortgages by Borrower ID & Pagination",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "mortgages-list-001"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/v1/mortgages?borrowerId=1&page=0&size=10",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "mortgages"],
              "query": [
                {
                  "key": "borrowerId",
                  "value": "1"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            },
            "description": "List mortgages filtered by borrower with pagination parameters."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Post Payment (Successful Transaction)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "payment-success-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dueDate\": \"2026-04-01\",\n  \"paidDate\": \"2026-04-02\",\n  \"amount\": 1000.00,\n  \"status\": \"POSTED\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/mortgages/1/payments",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "mortgages", "1", "payments"]
            },
            "description": "Post a valid payment transaction. Atomically inserts payment, reduces outstanding balance, and logs servicing history."
          },
          "response": []
        },
        {
          "name": "Post Payment (Validation Error Example)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "payment-error-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dueDate\": \"2026-04-01\",\n  \"paidDate\": \"2026-04-02\",\n  \"amount\": -50.00,\n  \"status\": \"POSTED\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/mortgages/1/payments",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "mortgages", "1", "payments"]
            },
            "description": "Triggers a validation error response (400 Bad Request) with the standardized error envelope."
          },
          "response": []
        },
        {
          "name": "Get Payments for Mortgage",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "payments-get-001"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/v1/mortgages/1/payments",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "mortgages", "1", "payments"]
            },
            "description": "Retrieve all payments associated with a specific mortgage."
          },
          "response": []
        }
      ]
    }
  ]
}