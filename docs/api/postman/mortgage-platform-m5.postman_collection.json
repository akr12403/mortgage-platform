{
  "info": {
    "name": "Capstone Mortgage Platform - M5",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Contract checks for mortgage-service (8080), servicing-service (8081) and analytics (8000). Run top to bottom; servicing/analytics reads are eventually consistent (wait ~5 s after writes). Set demoMtg/demoLoan to unused IDs before each run."
  },
  "variable": [
    {
      "key": "mortgageBaseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "servicingBaseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "analyticsBaseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "demoMtg",
      "value": "MTG-7001"
    },
    {
      "key": "demoLoan",
      "value": "LOAN-7001"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "mortgage-service health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{mortgageBaseUrl}}/actuator/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "servicing-service health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{servicingBaseUrl}}/actuator/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "analytics health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{analyticsBaseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Borrowers",
      "item": [
        {
          "name": "Get BOR-001",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{mortgageBaseUrl}}/api/v1/borrowers/BOR-001"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid borrower id -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{mortgageBaseUrl}}/api/v1/borrowers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"borrowerExternalId\": \"B1\",\n  \"firstName\": \"A\",\n  \"lastName\": \"B\",\n  \"email\": \"a@b.test\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('error envelope', () => { const b = pm.response.json(); ['code','message','correlationId','timestamp'].forEach(k => pm.expect(b).to.have.property(k)); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Mortgage lifecycle",
      "item": [
        {
          "name": "Create mortgage (PENDING loan) -> MortgageCreated",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{mortgageBaseUrl}}/api/v1/mortgages",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mortgageExternalId\": \"{{demoMtg}}\",\n  \"borrowerExternalId\": \"BOR-001\",\n  \"originalAmount\": 320000.0,\n  \"outstandingBalance\": 318500.0,\n  \"originationDate\": \"2025-06-01\",\n  \"loan\": {\n    \"loanExternalId\": \"{{demoLoan}}\",\n    \"interestRate\": 0.065,\n    \"termMonths\": 360,\n    \"underwritingDecision\": \"PENDING\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('PENDING', () => pm.expect(pm.response.json().status).to.eql('PENDING'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Duplicate mortgage -> 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{mortgageBaseUrl}}/api/v1/mortgages",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mortgageExternalId\": \"{{demoMtg}}\",\n  \"borrowerExternalId\": \"BOR-001\",\n  \"originalAmount\": 320000.0,\n  \"outstandingBalance\": 318500.0,\n  \"originationDate\": \"2025-06-01\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('error envelope', () => { const b = pm.response.json(); ['code','message','correlationId','timestamp'].forEach(k => pm.expect(b).to.have.property(k)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Approve loan -> LoanApproved",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{mortgageBaseUrl}}/api/v1/mortgages/{{demoMtg}}/underwriting-decision",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"APPROVED\",\n  \"decidedByRole\": \"UNDERWRITER\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('ACTIVE', () => pm.expect(pm.response.json().status).to.eql('ACTIVE'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get mortgage",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{mortgageBaseUrl}}/api/v1/mortgages/{{demoMtg}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown mortgage -> 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{mortgageBaseUrl}}/api/v1/mortgages/MTG-0000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('error envelope', () => { const b = pm.response.json(); ['code','message','correlationId','timestamp'].forEach(k => pm.expect(b).to.have.property(k)); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Post payment -> PaymentReceived",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "pay-{{demoMtg}}-2026-10-01"
              }
            ],
            "url": "{{mortgageBaseUrl}}/api/v1/mortgages/{{demoMtg}}/payments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dueDate\": \"2026-10-01\",\n  \"paidDate\": \"2026-10-02\",\n  \"amount\": 1850.0,\n  \"status\": \"POSTED\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay same Idempotency-Key (no new event)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "pay-{{demoMtg}}-2026-10-01"
              }
            ],
            "url": "{{mortgageBaseUrl}}/api/v1/mortgages/{{demoMtg}}/payments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dueDate\": \"2026-10-01\",\n  \"paidDate\": \"2026-10-02\",\n  \"amount\": 1850.0,\n  \"status\": \"POSTED\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('replayed', () => pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.eql('true'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid amount -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{mortgageBaseUrl}}/api/v1/mortgages/{{demoMtg}}/payments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dueDate\": \"2026-10-01\",\n  \"paidDate\": \"2026-10-02\",\n  \"amount\": -50.0,\n  \"status\": \"POSTED\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('error envelope', () => { const b = pm.response.json(); ['code','message','correlationId','timestamp'].forEach(k => pm.expect(b).to.have.property(k)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Failed payment 45+ days overdue -> PaymentMissed + LoanDelinquent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{mortgageBaseUrl}}/api/v1/mortgages/{{demoMtg}}/payments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dueDate\": \"2026-09-01\",\n  \"paidDate\": null,\n  \"amount\": 1850.0,\n  \"status\": \"FAILED\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "List payments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{mortgageBaseUrl}}/api/v1/mortgages/{{demoMtg}}/payments"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Run delinquency batch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{mortgageBaseUrl}}/api/v1/delinquency-evaluations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
