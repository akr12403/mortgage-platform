          ]
        },
        {
          "name": "Seeded delinquent MTG-1002",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{servicingBaseUrl}}/api/v1/mortgages/MTG-1002/delinquency"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('>=30 dpd', () => pm.expect(pm.response.json().daysPastDue).to.be.at.least(30));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown mortgage -> 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{servicingBaseUrl}}/api/v1/mortgages/MTG-0000/servicing-history"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
