{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capstone.local/schemas/events/mortgage-created.schema.json",
  "title": "MortgageCreated",
  "description": "A mortgage was created (status PENDING) by mortgage-service. Schema version 1.0.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "correlationId",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "UUID v4; consumers dedupe on this"
    },
    "eventType": {
      "const": "MortgageCreated"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "Major 1; minor bumps are additive only"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "description": "X-Correlation-Id of the triggering request (UUID v4 when generated)"
    },
    "payload": {
      "type": "object",
      "required": [
        "mortgageExternalId",
        "borrowerExternalId",
        "originalAmount",
        "status"
      ],
      "additionalProperties": true,
      "description": "additionalProperties allowed so producers can add optional fields in 1.x",
      "properties": {
        "mortgageExternalId": {
          "type": "string",
          "pattern": "^MTG-[0-9]{4}$",
          "description": "Mortgage business ID (never the internal UUID)"
        },
        "borrowerExternalId": {
          "type": "string",
          "pattern": "^BOR-[0-9]{3}$"
        },
        "originalAmount": {
          "type": "number",
          "minimum": 0,
          "description": "Original principal (2 decimal places)"
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "ACTIVE",
            "DELINQUENT",
            "CLOSED"
          ]
        }
      }
    }
  }
}
