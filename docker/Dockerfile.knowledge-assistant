# mortgage-knowledge-assistant (M7). Same layout as the analytics image: build / test / runtime stages.
# Default command: the FastAPI app on port 8001 (Task 7.4). The same image runs the one-off commands
# (python -m src.ingest, src.rag.ask, src.rag.calibrate, src.ops.summarize_incident) through the knowledge-ingest
# compose service.

# ---------- Build stage: compilers + headers live here only ----------
FROM python:3.14.7-slim AS builder
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*
RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH \
    TIKTOKEN_CACHE_DIR=/opt/tiktoken
COPY ai/mortgage-knowledge-assistant/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
# Download the tokenizer encoding once, at build time, so the container never fetches it at runtime.
RUN python -c "import tiktoken; tiktoken.get_encoding('cl100k_base')"

# ---------- Test stage (optional): docker build --target test ... ----------
FROM builder AS test
COPY ai/mortgage-knowledge-assistant/requirements-dev.txt /tmp/requirements-dev.txt
RUN cd /tmp && pip install --no-cache-dir -r requirements-dev.txt
WORKDIR /app
COPY ai/mortgage-knowledge-assistant/ ./
CMD ["python", "-m", "pytest", "-q", "-p", "no:cacheprovider", "tests"]

# ---------- Runtime stage (default): venv + source + corpus only, non-root ----------
FROM python:3.14.7-slim AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system app && useradd --system --gid app --no-create-home app
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /opt/tiktoken /opt/tiktoken
# The runtime never installs packages: remove pip (system + venv) and the CA bundle it vendors, which is pinned to
# pip's release and goes stale (GHSA-6q48-6c7w-9gw2 in pip's own certifi). The app uses the venv's certifi.
RUN /opt/venv/bin/python -m pip uninstall -y -q pip && /usr/local/bin/python -m pip uninstall -y -q pip
ENV PATH=/opt/venv/bin:$PATH \
    TIKTOKEN_CACHE_DIR=/opt/tiktoken \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app
COPY ai/mortgage-knowledge-assistant/src/ ./src/
COPY ai/mortgage-knowledge-assistant/knowledge/ ./knowledge/
# Read-only for the app user whatever the host file modes were (a 0600 checkout would otherwise be unreadable).
RUN chmod -R a+rX,go-w /app /opt/tiktoken
USER app
EXPOSE 8001
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD python -c "import sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://localhost:8001/health', timeout=3).status == 200 else 1)"
CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8001"]
