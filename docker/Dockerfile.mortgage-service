# Stage 1: Build using official Maven image
FROM maven:3.9.6-eclipse-temurin-17-jammy AS build
WORKDIR /app
COPY . .
RUN mvn clean package -pl services/mortgage-service -DskipTests

# Stage 2: Lightweight runtime image
FROM eclipse-temurin:17-jre-jammy
WORKDIR /app
RUN useradd -ms /bin/bash appuser
USER appuser
COPY --from=build /app/services/mortgage-service/target/*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]